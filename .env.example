# Lista de TODAS as variáveis de ambiente do projeto, sem valores reais (princípio U7).
# Copie para .env e preencha. O .env nunca vai para o git.
# Ao criar uma variável nova no código, acrescente aqui no mesmo commit.

# Ambiente: development | test | production
NODE_ENV=development
# APP_ENV=development        # equivalente para projetos Python

# Perfil Sistema (exemplos; apague o que não usar)
# DATABASE_URL=postgres://user:password@localhost:5432/app
# API_PORT=3000
# WEB_API_URL=http://localhost:3000

# Perfil Mobile: só variáveis públicas, com prefixo EXPO_PUBLIC_ (segredos ficam na API)
